APP_ENV=development
BASE_URL=http://dev.local.tld:3000
PUBLIC_DOMAIN=dev.local.tld
HYDRA_PUBLIC_URL=dev.local.tld
PRIVATE_HOST=dev.local.tld
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-secret
# Rotating file log directory (default /var/log/hydra-headless-ts)
# LOG_DIR=/var/log/hydra-headless-ts

# Redirect URIs clients may register and use (comma-separated, exact match). Loopback
# http://localhost / 127.0.0.1 / [::1] URIs on any port are also allowed unless
# ALLOW_LOOPBACK_REDIRECT_URIS=false. Default: the claude.ai and claude.com MCP callbacks.
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# ALLOW_LOOPBACK_REDIRECT_URIS=true
