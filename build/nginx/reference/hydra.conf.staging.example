# Rendered by salt from salt/hydra-headless-ts/etc/nginx/conf.d/hydra.conf.
# Captured from the staging host's /etc/nginx/conf.d/hydra.conf on 2026-10-13.
#
# NOT mounted anywhere. This is the baseline for scripts/check-nginx-drift.sh,
# which compares it against build/nginx/dev/conf.d/hydra.conf. Refresh with:
#   ssh <staging-host> cat /etc/nginx/conf.d/hydra.conf > /tmp/hydra.conf.staging
# then replace everything below this header with it, and update the date above.
#
# A stale baseline is the one failure mode of the drift check, so the script
# prints the date above on every run. Everything below the header is the
# verbatim capture, with no hand edits.

js_import discovery_filter.js;
upstream public_api {
  server 10.1.2.230:4444;
}
upstream admin_api {
  server 10.1.2.230:4445;
}

upstream mcp-tools {
  server 10.1.2.230:9001;
}

upstream hydra-headless-ts {
  server 10.1.2.230:3000;
}

upstream mcp-tools-stagingdb05 {
  server 10.1.2.230:9010;
}

upstream mcp-tools-stagingdb02 {
  server 10.1.2.230:9011;
}
map $request_uri $mcp_resource {
  default "";
  ~^/db-tools "db-tools";
  ~^/db-tools/stagingdb05 "db-tools/stagingdb05";
  ~^/db-tools/stagingdb02 "db-tools/stagingdb02";
}
geo $remote_addr $mcp_healthcheck_source_ip {
  default 0;
  10.1.0.125 1;
  10.1.0.50 1;
}
map $http_x_healthcheck $mcp_healthcheck_source_id {
  default 0;
  staginglb02 1;
  staginglb04 1;
}
map $http_x_real_ip $mcp_healthcheck_not_client {
  default 0;
  "" 1;
}
map "$mcp_healthcheck_source_ip:$mcp_healthcheck_source_id:$mcp_healthcheck_not_client" $mcp_healthcheck_bypass {
  default 0;
  "1:1:1" 1;
}
map "$mcp_healthcheck_bypass:$mcp_resource" $mcp_healthcheck_bypass_resource {
  default 0;
  "1:db-tools" 1;
}

server {
  listen 80;
  server_name oauth.staging.bondlink.org oauth-passive.staging.bondlink.org;
  add_header 'Access-Control-Allow-Credentials' 'true';
  location ~ ^(.+)/$ {
    return 301 $scheme://$host$1;
  }

  location ~ ^/(admin|clients|keys|health|metrics|version|oauth2/auth/requests|oauth2/introspect|oauth2/flush) {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    proxy_pass http://admin_api;
    proxy_redirect    off;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header  Host               $host;
    proxy_set_header  X-Real-IP          $remote_addr;
    proxy_set_header  X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header  X-Forwarded-Proto  $http_x_forwarded_proto;
    proxy_set_header X-CSRF-TOKEN $http_x_csrf_token;
    proxy_set_header X-XSRF-TOKEN $http_x_xsrf_token;
  }
  location = /_discovery_upstream {
    internal;
    proxy_pass http://hydra-headless-ts/.well-known/oauth-authorization-server;
  }

  location = /.well-known/oauth-authorization-server {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    js_content discovery_filter.hide_dcr;
  }
  # oauth2/auth and oauth2/token && oauth2/register are managed by hydra-headless-ts
  # the former is proxied to hydra, the latter is all in the application
  location ~ ^/(.well-known|oauth2/sessions|oauth2/revoke|oauth2/fallbacks/consent|oauth2/fallbacks/error|userinfo) {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    proxy_pass http://public_api;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header  Host              "oauth.staging.bondlink.org";
    proxy_set_header  X-Real-IP         $remote_addr;
    proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header  X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-CSRF-TOKEN $http_x_csrf_token;
    proxy_set_header X-XSRF-TOKEN $http_x_xsrf_token;
  }

  location = /.well-known/oauth-protected-resource {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    alias /var/www/html/auth/.well-known/oauth-protected-resource/index.json;
    add_header Content-Type application/json;
  }


  location /hostname.html {
    root /var/www/html;
    add_header X-HAProxy-Force-Backend stagingops;
    try_files $uri =404;
  }
  location /hostname {
    root /var/www/html;
    add_header X-HAProxy-Force-Backend stagingops;
    try_files $uri =404;
  }

  location = /.well-known/oauth-protected-resource/db-tools {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    alias /var/www/html/auth/.well-known/oauth-protected-resource/db-tools.json;
    add_header Content-Type application/json;
  }

  location = /.well-known/oauth-protected-resource/db-tools/stagingdb05 {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    alias /var/www/html/auth/.well-known/oauth-protected-resource/db-tools_stagingdb05.json;
    add_header Content-Type application/json;
  }

  location = /.well-known/oauth-protected-resource/db-tools/stagingdb02 {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    alias /var/www/html/auth/.well-known/oauth-protected-resource/db-tools_stagingdb02.json;
    add_header Content-Type application/json;
  }


  location / {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    try_files $uri $uri/ @hydra-headless-ts;
  }

  location @hydra-headless-ts {
    proxy_pass http://hydra-headless-ts;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header  Host              "oauth.staging.bondlink.org";
    proxy_set_header  X-Real-IP         $remote_addr;
    proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header  X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-CSRF-TOKEN $http_x_csrf_token;
    proxy_set_header X-XSRF-TOKEN $http_x_xsrf_token;
  }

  location = /_authz {
    internal;
    if ($mcp_healthcheck_bypass_resource = 1) {
      return 200;
    }
    proxy_pass http://hydra-headless-ts/authz;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host "oauth.staging.bondlink.org";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-MCP-Resource $mcp_resource;
    proxy_set_header Authorization $http_authorization;
  }
  location @mcp_unauthorized {
    add_header 'Access-Control-Allow-Origin' "$http_origin" always;
    add_header 'Vary' 'Origin' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;
    add_header 'WWW-Authenticate' 'Bearer resource_metadata="https://$host/.well-known/oauth-protected-resource/$mcp_resource"' always;
    return 401;
  }

  location /db-tools {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    auth_request /_authz;
    error_page 401 = @mcp_unauthorized;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Accept-Encoding "";
    chunked_transfer_encoding on;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://mcp-tools/mcp;
  }

  location ~ ^/(consent|logout|auth|callback|oauth2) {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Accept-Encoding "";
    chunked_transfer_encoding on;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://hydra-headless-ts;
  }

  location /db-tools/stagingdb05 {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    auth_request /_authz;
    error_page 401 = @mcp_unauthorized;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Accept-Encoding "";
    chunked_transfer_encoding on;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://mcp-tools-stagingdb05/mcp;
  }

  location /db-tools/stagingdb02 {
    include /etc/nginx/cors_headers;
    include /etc/nginx/options_request;
    auth_request /_authz;
    error_page 401 = @mcp_unauthorized;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Accept-Encoding "";
    chunked_transfer_encoding on;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://mcp-tools-stagingdb02/mcp;
  }

}
