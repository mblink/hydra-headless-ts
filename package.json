{
  "name": "hydra-login-consent-logout",
  "version": "2.4.0-pre.3",
  "private": true,
  "type": "module",
  "main": "dist/app-fp.js",
  "scripts": {
    "_tsc": "tsc -p .",
    "tswatch": "tsc --watch -p .",
    "_bundle": "rollup -c",
    "build": "npm-run-all clean lint format:check _tsc _bundle",
    "ci": "npm-run-all clean lint format:check _tsc test",
    "clean": "rm -rf lib dist",
    "cli": "node --enable-source-maps --loader ts-node/esm --env-file=./src/env/local.env src/cli.ts",
    "cli:env": "node --enable-source-maps --loader ts-node/esm src/cli.ts",
    "cli:staging": "node --enable-source-maps --loader ts-node/esm --env-file=./src/env/staging.env src/cli.ts",
    "cli:production": "node --enable-source-maps --loader ts-node/esm --env-file=./src/env/production.env src/cli.ts",
    "validate-token": "node --enable-source-maps --loader ts-node/esm --env-file=/etc/hydra-headless-ts/local.env src/cli-validate-token.ts",
    "validate-token:staging": "node --enable-source-maps --loader ts-node/esm --env-file=/etc/hydra-headless-ts/staging.env src/cli-validate-token.ts",
    "validate-token:production": "node --enable-source-maps --loader ts-node/esm --env-file=/etc/hydra-headless-ts/production.env src/cli-validate-token.ts",
    "serve": "node --env-file=/etc/hydra-headless-ts/staging.env dist/app-fp.js",
    "serve:local": "NODE_ENV='--env-file=/etc/hydra-headless-ts/hydra.env' node --enable-source-maps --loader ts-node/esm dist/app-fp.js",
    "serve:staging": "NODE_ENV=production node --enable-source-maps dist/app-fp.js",
    "serve:prod": "NODE_ENV=production node --enable-source-maps dist/app-fp.js",
    "serve:production": "NODE_ENV=production node --enable-source-maps dist/app-fp.js",
    "serve:dev": "node --enable-source-maps --loader ts-node/esm --env-file=/etc/hydra-headless-ts/local.env dist/app-fp.js",
    "start": "node --enable-source-maps --watch --env-file=/etc/hydra-headless-ts/local.env dist/app-fp.js",
    "start:local": "node --enable-source-maps --watch --env-file=/etc/hydra-headless-ts/local.env dist/app-fp.js",
    "start:staging": "node --enable-source-maps --watch --env-file=/etc/hydra-headless-ts/hydra.env dist/app-fp.js",
    "start:production": "node --enable-source-maps --watch --env-file=/etc/hydra-headless-ts/hydra.env dist/app-fp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:nginx-drift": "bash scripts/check-nginx-drift.sh",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm-run-all typecheck lint test check:nginx-drift"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.13",
    "@ory/client-fetch": "^1.22.66",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.6",
    "effect": "^3.22.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.2.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "npm-run-all": "^4.1.5",
    "rotating-file-stream": "^3.2.10",
    "serve-favicon": "^2.5.1",
    "tslib": "^2.8.1",
    "tslog": "^5.2.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@ory/hydra-client-fetch": "^26.2.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/serve-favicon": "^2.5.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "rollup": "^4.64.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
